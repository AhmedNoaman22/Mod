<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Riightecchs list of analytic_items Inherit for overtime -->
        <record id="hr_timesheet_line_tree_inherit_overtime" model="ir.ui.view">
            <field name="name">account.analytic.line.list.hr_timesheet.overtime</field>
            <field name="model">account.analytic.line</field>
            <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='unit_amount']" position="after">
                    <field name="overtime" optional="show"/>
                    <!--                    <field name="overtime_amount" optional="show" sum="Total" readonly="readonly_timesheet"/>-->
                </xpath>
            </field>
        </record>

        <!-- Riightecchs form of analytic_items Inherit for overtime -->
        <record id="hr_timesheet_line_form_inherit_overtime" model="ir.ui.view">
            <field name="name">account.analytic.line.form.overtime</field>
            <field name="model">account.analytic.line</field>
            <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='unit_amount']" position="after">
                    <field name="overtime"/>
<!--                    <field name="indirect_amount"/>-->
                    <!--                    <field name="overtime_amount" optional="show" sum="Total" readonly="readonly_timesheet"/>-->
                </xpath>
            </field>
        </record>


    </data>
</odoo>
