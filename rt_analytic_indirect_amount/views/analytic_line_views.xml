<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Riightecchs list of analytic_items Inherit for indirect Amount -->
        <record id="view_account_analytic_line_tree_inherit_indirect" model="ir.ui.view">
            <field name="name">account.analytic.line.list</field>
            <field name="model">account.analytic.line</field>
            <field name="inherit_id" ref="analytic.view_account_analytic_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='amount']" position="after">
                    <field name="indirect_amount" optional="show" sum="Total Indirect Amount"/>
                    <field name="final_amount" optional="show" sum="Total Final Amount"/>
                </xpath>
            </field>
        </record>

        <!-- Riightecchs form of analytic_items Inherit for indirect Amount -->
        <record id="view_account_analytic_line_form_inherit_indirect" model="ir.ui.view">
            <field name="name">account.analytic.line.form</field>
            <field name="model">account.analytic.line</field>
            <field name="priority">1</field>
            <field name="inherit_id" ref="analytic.view_account_analytic_line_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='amount']" position="after">
                    <field name="indirect_amount"/>
                    <field name="final_amount"/>
                </xpath>
            </field>
        </record>

        <!-- Riightecchs pivot of analytic_items Inherit for indirect Amount -->
        <record id="view_account_analytic_line_pivot_inherit_indirect" model="ir.ui.view">
            <field name="name">account.analytic.line.pivot</field>
            <field name="model">account.analytic.line</field>
            <field name="inherit_id" ref="analytic.view_account_analytic_line_pivot"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='amount']" position="after">
                    <field name="indirect_amount" type="measure"/>
                    <field name="final_amount" type="measure"/>
                </xpath>
            </field>
        </record>

        <!-- Riightecchs kanban of analytic_items Inherit for indirect Amount -->
        <record id="view_account_analytic_line_kanban_inherit_indirect" model="ir.ui.view">
            <field name="name">account.analytic.line.kanban</field>
            <field name="model">account.analytic.line</field>
            <field name="inherit_id" ref="analytic.view_account_analytic_line_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='amount']" position="replace">
                </xpath>
                <xpath expr="//t" position="inside">
                    <div class="d-flex justify-content-between">
                        <label for="amount" string="Amount"/>
                        <field class="justify-content-end" name="amount" widget="monetary"/>
                    </div>
                    <div class="d-flex justify-content-between">
                        <label for="indirect_amount" string="Indirect Amount"/>
                        <field class="justify-content-end" name="indirect_amount" widget="monetary"/>
                    </div>
                    <div class="d-flex justify-content-between">
                        <label for="final_amount" string="Final Amount"/>
                        <field class="justify-content-end" name="final_amount" widget="monetary"/>
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
