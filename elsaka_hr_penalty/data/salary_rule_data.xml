<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="LEAVE" model="hr.salary.rule.category">
            <field name="name">Leaves</field>
            <field name="code">DED</field>
        </record>

        <!--*********** Paid Leaves ************** -->
        <record id="hr_salary_rule_input_leaves_days" model="hr.payslip.input.type">
            <field name="code">CLD</field>
            <field name="name">Total Leave Days</field>
            <field name="struct_ids" eval="[(4, ref('hr_payroll.structure_002'))]" />
        </record>

        <record id="hr_salary_rule_input_leaves_amount" model="hr.payslip.input.type">
            <field name="code">LDA</field>
            <field name="name">Total Leave Amount</field>
            <field name="struct_ids" eval="[(4, ref('hr_payroll.structure_002'))]" />
        </record>

        <!--*********** Rest Days ************** -->
        <record id="hr_salary_rule_input_count_rest_days" model="hr.payslip.input.type">
            <field name="code">CRD</field>
            <field name="name">Rest Days</field>
            <field name="struct_ids" eval="[(4, ref('hr_payroll.structure_002'))]" />
        </record>
        <record id="hr_salary_rule_input_leaves_rest_days" model="hr.payslip.input.type">
            <field name="code">RDA</field>
            <field name="name">Rest Days Amount</field>
            <field name="struct_ids" eval="[(4, ref('hr_payroll.structure_002'))]" />
        </record>

        <!--*********** Attendance Days ************** -->
        <record id="hr_salary_rule_input_count_attendance_days" model="hr.payslip.input.type">
            <field name="code">CATD</field>
            <field name="name">Attendance Days</field>
            <field name="struct_ids" eval="[(4, ref('hr_payroll.structure_002'))]" />
        </record>

        <record id="hr_salary_rule_input_attendance_days" model="hr.payslip.input.type">
            <field name="code">ATDA</field>
            <field name="name">Attendance Amount</field>
            <field name="struct_ids" eval="[(4, ref('hr_payroll.structure_002'))]" />
        </record>

    </data>
</odoo>