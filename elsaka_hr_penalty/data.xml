<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data noupdate="1">

	<!-- Holidays-related subtypes for messaging / Chatter -->
	<record id="mt_delay_draft" model="mail.message.subtype">
		<field name="name">Draft</field>
		<field name="res_model">employee.delay</field>
		<field name="description">Draft Employee Delay</field>
	</record>
	<record id="mt_delay_1approve" model="mail.message.subtype">
		<field name="name">Approved</field>
		<field name="res_model">employee.delay</field>
		<field name="description">Request Approved</field>
	</record>
	<record id="mt_delay_2approve" model="mail.message.subtype">
		<field name="name">First Approved</field>
		<field name="res_model">employee.delay</field>
		<field name="description">Request Approved</field>
	</record>
	<record id="mt_delay_approved" model="mail.message.subtype">
		<field name="name">Approved</field>
		<field name="res_model">employee.delay</field>
		<field name="description">Second Approved</field>
	</record>
	<record id="mt_delay_refuse" model="mail.message.subtype">
		<field name="name">Refuse</field>
		<field name="res_model">employee.delay</field>
		<field name="description">Request Refused</field>
	</record>

	</data>
</odoo>