<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

	<record model="ir.ui.view" id="edit_holiday_status_form_inherit_1">
		<field name="name">hr.leave.type.form</field>
		<field name="model">hr.leave.type</field>
		<field name="inherit_id" ref="hr_holidays.edit_holiday_status_form" />
		<field name="priority">18</field>
		<field name="arch" type="xml">
			<xpath expr="//group" position="after">
				<group string="Leave Rules">
					<field name="leave_rule" widget="radio" nolabel="1" colspan="4" />
					<field name="rule_ids" nolabel="1" invisible="leave_rule != 'all'">
						<list editable="bottom">
<!--							<field name="max_or_min_times" />-->
							<field name="no" />
							<field name="unit" />
							<field name="per" />
						</list>
					</field>
				</group>
			</xpath>
		</field>
	</record>

	</data>
</odoo>