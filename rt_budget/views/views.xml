<odoo>
    <data>

        <record model="ir.ui.view" id="rt_budget_form">
            <field name="name">rt_budget form</field>
            <field name="model">project.budget</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_to_confirm" invisible="state != 'draft'" string="To Confirm" type="object"
                                groups="rt_budget.group_project_budget_internal_user"
                                class="oe_highlight"
                                data-hotkey="l"/>
                        <button name="action_confirm"
                                string="Confirm" type="object"
                                invisible="state != 'to_confirm'"
                                groups="rt_budget.group_project_budget_manager"
                                class="oe_highlight"
                                data-hotkey="m"/>
                        <button name="action_done"
                                string="Approve" type="object"
                                invisible="state != 'confirmed'"
                                groups="rt_budget.group_project_budget_manager"
                                class="oe_highlight"
                                data-hotkey="m"/>
                        <button name="action_reset" invisible="state in ('draft','confirmed','done')" string="Reset" type="object"
                                class="oe_highlight" groups="base.group_user" data-hotkey="q"/>
                        <field name="state" widget="statusbar" readonly="1"/>
                        <button name="action_cancel" invisible="state in ('confirmed','done', 'cancel')" string="Cancel"
                                groups="base.group_user" type="object" data-hotkey="x"/>

                    </header>
                    <sheet>
                        <field name="state" incvisible="1"/>
                        <div id="budget" name="Budget">
                            <group>
                                <group>
                                    <field name="name"/>
                                </group>
                                <group>
                                    <field name="date_from"/>
                                </group>
                            </group>
                        </div>
                        <group>
                            <group>
                                <field name="company_id"/>
                            </group>
                            <group>
                                <field name="date_to"/>
                            </group>
                            <group>
                                <field name="project_id" readonly="state == 'done'"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="budget" string="Budget">
                                <field name="budget_line_ids" mode="list,kanban" widget="one2many">
                                    <list string="budget" editable="bottom">
                                        <field name="name"/>
                                        <field name="department_id"/>
                                        <field name="amount_planing_hours"/>
                                        <field name="task_planned_hours"/>
                                        <field name="multiplier" force_save="1"/>
                                        <field name="hour_cost" force_save="1" readonly="1"/>
                                        <field name="actually_cost_hour"/>
                                        <field name="amount_actually_hours"/>
                                        <field name="actually_time_sheet_hour"/>
<!--                                        <field name="actually_cost_hours"/>-->
                                        <field name="pm_percentage"/>
                                        <field name="etc_hours"/>
                                        <field name="etc_cost_planned"/>
<!--                                        <field name="note"/>-->
                                    </list>
                                </field>
                            </page>
                            <page name="note" string="Note">
                                <field name="note"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>


        <record model="ir.ui.view" id="rt_budget_list">
            <field name="name">rt_budget list</field>
            <field name="model">project.budget</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record model="ir.actions.act_window" id="budget_action_window">
            <field name="name">Project Budget Action Window</field>
            <field name="res_model">project.budget</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem name="Budget Department" id="project_budget_menu"
                  parent="project.menu_main_pm"
                  sequence="152" />
        <menuitem name="Budgets" id="budget_model_menu"
                  parent="project_budget_menu"
                  sequence="0"
                  action="budget_action_window"/>
    </data>
</odoo>
