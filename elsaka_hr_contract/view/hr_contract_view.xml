<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherit Form View to Modify it -->
        <record id="view_hr_contract_form" model="ir.ui.view">
            <field name="name">view.hr.contract.form</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='information']/group[@name='salary_info']/group[@name='yearly_benefits']"
                       position="inside">
                    <field name="basic_insurance" readonly="state in ['open', 'close']"/>
                    <field name="variable_insurance" readonly="state in ['open', 'close']"/>
                    <field name="holiday_start_date" readonly="state in ['open', 'close']"/>
                </xpath>
                <xpath expr="//page[@name='information']/group[@name='salary_info']/group[@name='salary']/div[@name='wage']"
                       position="after">
                    <label for="gross"/>
                    <div class="o_row" name="gross">
                        <field name="gross" nolabel="1" required="1" readonly="state in ['open', 'close']"/>
                        <span>/ month</span>
                    </div>
                </xpath>
            </field>
        </record>
        <record id="hr_contract_view_tree_inherit" model="ir.ui.view">
            <field name="name">hr.contract.view.tree.inherit</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="hr_contract.hr_contract_view_tree"/>
            <field name="arch" type="xml">
                <field name="job_id" position="after">
                    <field name="department_id"/>
                </field>
            </field>
        </record>

        <record id="hr_contract_view_search_inherit" model="ir.ui.view">
            <field name="name">hr.contract.search</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="hr_contract.hr_contract_view_search"/>
            <field name="arch" type="xml">
                <xpath expr="//group/filter" position="inside">
                    <filter string="Department" name="department" domain="[]" context="{'group_by':'department_id'}"/>
                </xpath>
            </field>
        </record>

        <menuitem id="hr_contract.hr_menu_contract" name="Contracts" action="hr_contract.action_hr_contract"
                  parent="hr.menu_hr_root" sequence="4" groups="base.group_user"/>
        <record id="edit_holiday_status_form_elsaka_hr_contract" model="ir.ui.view">
            <field name="name">hr.leave.type.form.elsaka.hr.contract</field>
            <field name="model">hr.leave.type</field>
            <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group/group" position="inside">
                    <field name="can_be_taken"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>