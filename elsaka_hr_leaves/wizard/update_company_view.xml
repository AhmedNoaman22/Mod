<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

	<record id="wizard_update_company_form" model="ir.ui.view">
		<field name="name">update.company.form</field>
		<field name="model">update.company</field>
		<field name="arch" type="xml">
			<form string="Update Company">
				<p class="oe_grey">
					Click on Update Company button to update company based on Analytic Journal
					instead of Analytic Account.
				</p>
				<footer>
					<button name="do_update" string="Update Company" type="object" class="oe_highlight" />
					or
					<button string="Cancel" class="oe_link" special="cancel" />
				</footer>
			</form>
		</field>
	</record>

	<record id="action_wizard_update_company" model="ir.actions.act_window">
		<field name="name">Update Company</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">update.company</field>
<!--		<field name="view_type">form</field>-->
		<field name="view_mode">form</field>
		<field name="target">new</field>
		<field name="binding_model_id" ref="analytic.model_account_analytic_line" />
	</record>

	</data>
</odoo>