        <record model="hr.leave.type" id="holiday_status_emg">
            <field name="name">Emergency Leaves</field>
            <field name="emergency">True</field>
        </record>

    </data>
    <data noupdate="0">

        <record forcecreate="True" id="ir_cron_permission_balance" model="ir.cron">
            <field name="name">Permission Balance</field>
            <field eval="False" name="active"/>
